# CCTV Search Environment Configuration
# Copy this file to .env and adjust variables as needed

# Storage Paths
CCTV_DATA_DIR=data
CCTV_DB_PATH=data/db/cctv_events.db

# Processing Settings (CPU-first by default)
CCTV_DEVICE=cpu
CCTV_FRAME_STRIDE=5
CCTV_IMG_SIZE=640
CCTV_MAX_SECONDS=0

# Logging Level (DEBUG, INFO, WARNING, ERROR)
CCTV_LOG_LEVEL=INFO
